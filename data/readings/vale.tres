[gd_resource type="Resource" script_class="Reading" format=3]

[ext_resource type="Script" path="res://game/data/reading.gd" id="1_reading"]

[resource]
script = ExtResource("1_reading")
id = "vale"
title = "Reading: Ines Vale"
source = 1
readable_until = "02:15"
surface_text = "Surface reading. Her last hour comes in pieces: the stall's hum, the cold of the freezers she rented, fear without a face. Nothing you could put on a board."
surface_clue = ""
deep_text = "Deep reading. You go under with her. The stall is shut, it's ten past midnight, and she's opening the door to someone. Reyka left hours ago. Then white, where a face should be. You come up with her still behind your eyes."
deep_clue = "vale_last"
deep_cost = 3
passenger = "Ines Vale"
insight = "He was in her memory and then he wasn't. Her last minutes were wiped out around him, cleanly, while she died."
