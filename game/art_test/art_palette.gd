class_name ArtPalette
extends RefCounted
## The Look and Feel doc's starting palette for the style test, plus the in-between
## shades the scene needs. Tune by eye here; everything in the art test reads from it.

# The doc's eight anchors.
const NAVY: Color = Color("0b1220")      # deep navy
const STORM: Color = Color("1c2a3f")     # storm blue
const CONCRETE: Color = Color("4a5563")  # wet concrete
const RAIN: Color = Color("8a96a6")      # rain grey
const MAGENTA: Color = Color("ff2e88")   # neon magenta
const CYAN: Color = Color("2ee6ff")      # hologram cyan
const AMBER: Color = Color("ffb347")     # sodium amber: old street lights, the market
const BLOOD: Color = Color("8e1622")     # kept for blood and little else

# Shades between them.
const INK: Color = Color("05080f")
const NIGHT: Color = Color("08101b")
const DEEP: Color = Color("111b2b")
const SLATE: Color = Color("26354b")
const STEEL: Color = Color("33404f")
const FOG: Color = Color("5f6b7c")
const WATER: Color = Color("060d16")
const RUST: Color = Color("4a2d26")
const TARP: Color = Color("2b3a3a")
const AMBER_DIM: Color = Color("8a5a2a")
const MAGENTA_DIM: Color = Color("7a1d4a")
const CYAN_DIM: Color = Color("1b6f84")
const SKIN: Color = Color("9a7b6c")
